PORT=5000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/team_management?schema=public"
JWT_SECRET="change_this_to_a_long_random_string"
JWT_EXPIRES_IN="7d"
CLIENT_ORIGIN="http://localhost:5173"

# Email (for password reset / verification links). Free option: a Gmail
# account with 2-Step Verification on, and an "App Password" generated at
# https://myaccount.google.com/apppasswords (NOT your normal Gmail password).
# If left blank, emails are logged to the server console instead of sent —
# useful for local development without real credentials.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="TeamFlow <youraddress@gmail.com>"
